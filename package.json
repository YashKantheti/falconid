    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
