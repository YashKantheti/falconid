# Server-side only. Set in Vercel Production environment, never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Optional override; must support image inputs and structured outputs.
OPENROUTER_VISION_MODEL=openai/gpt-6.1-terra
# Optional structured text model for evidence-grounded manual chat.
OPENROUTER_CHAT_MODEL=openai/gpt-6.1-terra
# Optional separate signing secret; Production otherwise derives a purpose-specific key from the private Blob credential.
MANUAL_CHAT_SIGNING_SECRET=
# Shared fixed-window limits; all must be integers between 1 and 1000.
MANUAL_CHAT_IP_MINUTE_LIMIT=8
MANUAL_CHAT_IP_HOUR_LIMIT=40
MANUAL_CHAT_GLOBAL_DAILY_LIMIT=200
